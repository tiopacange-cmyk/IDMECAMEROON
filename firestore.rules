rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function isActive() {
      return signedIn() && exists(profilePath()) && get(profilePath()).data.active == true;
    }
    function myRole() {
      return get(profilePath()).data.role;
    }
    function isAdmin() {
      return isActive() && myRole() in ['Admin', 'Super Admin'];
    }
    function isSuperAdmin() {
      return isActive() && myRole() == 'Super Admin';
    }
    function isResponsableOrAbove() {
      return isActive() && myRole() in ['Responsable', 'Admin', 'Super Admin'];
    }
    function basicRoles() {
      return ['Agent', 'Responsable'];
    }
    function setupPath() {
      return /databases/$(database)/documents/appdata/setup;
    }
    match /users/{uid} {
      allow read: if isActive() && (request.auth.uid == uid || isAdmin());
      allow create: if ((isSuperAdmin()
                        || (isAdmin() && request.resource.data.role in basicRoles()))
                    && request.resource.data.active == true)
          || (signedIn() && request.auth.uid == uid
              && !exists(setupPath()) && existsAfter(setupPath())
              && request.resource.data.role == 'Super Admin'
              && request.resource.data.active == true);
      allow update: if
          (isSuperAdmin()
            && (uid != request.auth.uid
                || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'active', 'username'])))
       || (isAdmin() && uid != request.auth.uid
            && resource.data.role in basicRoles()
            && request.resource.data.role in basicRoles()
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['username']))
       || (isActive() && uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword'])
            && request.resource.data.mustChangePassword == false);
      allow delete: if false;
    }
    match /logins/{username} {
      allow get: if true;
      allow create, update: if existsAfter(/databases/$(database)/documents/users/$(request.resource.data.uid))
          && getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.username == username
          && (
            isSuperAdmin()
            || (isAdmin()
                && getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.role in basicRoles()
                && (resource == null
                    || get(/databases/$(database)/documents/users/$(resource.data.uid)).data.role in basicRoles()))
            || (signedIn() && request.resource.data.uid == request.auth.uid
                && !exists(setupPath()) && existsAfter(setupPath()))
          );
      allow delete: if false;
    }
    match /appdata/setup {
      allow get: if true;
      allow create: if signedIn() && !exists(setupPath())
                    && existsAfter(profilePath())
                    && getAfter(profilePath()).data.role == 'Super Admin'
                    && getAfter(profilePath()).data.active == true;
      allow update, delete: if false;
    }
    match /dossiers/{id} {
      allow read, write: if isActive();
    }
    match /fichiers/{id} {
      allow read, write: if isActive();
    }
    match /appdata/dossiers {
      allow read, write: if isActive();
    }
    match /appdata/migration {
      allow read, write: if isActive();
    }
    match /appdata/logs {
      allow read, write: if isActive();
    }
    match /appdata/config {
      allow read: if isActive();
      allow write: if isResponsableOrAbove();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
